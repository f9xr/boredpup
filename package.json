{
  "name": "boredpup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BoredPuP - free online games portal powered by GameMonetize, GameDistribution, and yupi.io.",
  "scripts": {
    "build:feed": "node scripts/build-feed.mjs",
    "build:feed:offline": "node scripts/build-feed.mjs --offline",
    "build:yupi": "node scripts/build-yupi.mjs",
    "build:gd": "node scripts/build-gd.mjs",
    "build:all": "node scripts/build-yupi.mjs && node scripts/build-gd.mjs && node scripts/build-feed.mjs",
    "sync:base": "node scripts/sync-base-url.mjs",
    "sync:csp": "node scripts/inject-csp.mjs",
    "sync": "node scripts/sync-base-url.mjs && node scripts/inject-csp.mjs",
    "validate": "node scripts/validate.mjs",
    "test:data": "node scripts/test-data.mjs",
    "test": "node scripts/validate.mjs && node scripts/test-data.mjs",
    "serve": "node scripts/serve.mjs . 8080"
  },
  "engines": {
    "node": ">=18"
  }
}